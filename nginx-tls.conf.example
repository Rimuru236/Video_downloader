# Example HTTPS server block for StreamVault's frontend/proxy container.
#
# This is NOT wired in by default — docker-compose.yml ships HTTP-only.
# TLS termination is deployment-specific (which domain, which cert issuer,
# whether you're already behind another reverse proxy that terminates TLS
# for you), so it can't be made automatic without making assumptions that
# would be wrong for most deployments. See the "TLS" section in README for
# how to use this file.
#
# To use: get a certificate + private key onto the host (e.g. via certbot,
# or a self-signed one for local testing — see README), copy this file to
# nginx-tls.conf, adjust server_name and the cert paths below if needed,
# then bring the stack up with the TLS override:
#   docker compose -f docker-compose.yml -f docker-compose.tls.yml up --build

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Plain HTTP requests get redirected to HTTPS rather than served directly.
server {
    listen 8080;
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    # >1024 — same reason as nginx.conf's 8080: this container runs nginx as
    # a non-root user (see Dockerfile.frontend / DEP-1), which can't bind
    # a privileged port. Map the host's real 443 to this in
    # docker-compose.tls.yml, not by changing this number.
    listen 8443 ssl;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # DEP-2: baseline security headers, including HSTS now that this block
    # actually serves HTTPS. max-age is intentionally modest (1 day) rather
    # than the commonly-copied 1-year value — this is a self-hosted example
    # config, not a vetted production HSTS policy, and a too-long max-age on
    # a misconfigured cert is much harder to walk back than a short one.
    add_header Strict-Transport-Security "max-age=86400; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;

    # SPA routing — always serve index.html for client routes
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy API calls to backend — includes /api/v1/ws/... (WebSocket
    # progress updates), so Upgrade/Connection headers must be forwarded.
    location /api/ {
        proxy_pass         http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection $connection_upgrade;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript;
    gzip_min_length 1000;
}
