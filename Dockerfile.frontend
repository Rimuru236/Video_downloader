FROM node:20-alpine AS builder

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install

COPY frontend/ .
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

# DEP-1: run nginx as the image's existing non-root `nginx` user instead of
# root. That means binding a port >1024 (root's CAP_NET_BIND_SERVICE is what
# normally lets nginx bind 80/443) — see nginx.conf's `listen 8080`, mapped
# back to the familiar host port 3000 in docker-compose.yml. The runtime
# dirs nginx writes to (cache, pid file, logs) need to be owned by that user
# too, since the base image otherwise sets them up for a root master process.
RUN chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/log/nginx \
    && touch /var/run/nginx.pid \
    && chown nginx:nginx /var/run/nginx.pid
USER nginx

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
